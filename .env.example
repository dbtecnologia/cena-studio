# O servidor carrega este arquivo quando executado com variáveis já exportadas.
# Nunca coloque uma chave no navegador ou commite um arquivo .env.

# Supabase: publishable/anon é seguro para o servidor com RLS; nunca use service_role no navegador.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Camada gratuita Gemini Developer API. Não ative faturamento para este MVP.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Apenas habilite quando você tiver um provedor de vídeo com acesso confirmado.
# O produto não usa fallback não-oficial nem ativa cobrança.
VIDEO_PROVIDER=
VIDEO_PROVIDER_API_KEY=

# Renderização e alinhamento locais opcionais.
FFMPEG_BIN=ffmpeg
WHISPER_CPP_BIN=
WHISPER_MODEL=
PIPER_BIN=
PIPER_MODEL=
PORT=4173


